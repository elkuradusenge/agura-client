{
  "name": "agura-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:em-dash": "node scripts/check-no-em-dash.mjs",
    "check:icons": "node scripts/check-lucide-only.mjs",
    "check:font": "node scripts/check-google-sans-only.mjs",
    "check:all": "yarn run typecheck && yarn run check:em-dash && yarn run check:icons && yarn run check:font && yarn run check:colors && yarn run test",
    "check:colors": "node scripts/check-no-hardcoded-colors.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  },
  "resolutions": {
    "vite": "^6.0.5"
  },
  "packageManager": "yarn@1.22.22"
}
